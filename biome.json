{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "domains": { "test": "recommended" },
    "rules": {
      "preset": "recommended",
      "complexity": { "noForEach": "off" },
      "style": { "noNonNullAssertion": "warn" }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.turbo",
      "!**/.next",
      "!**/.astro",
      "!**/*.json"
    ]
  },
  "overrides": [
    {
      "includes": ["internals/api/src/generated/**"],
      "linter": { "enabled": false },
      "assist": { "enabled": false }
    }
  ]
}
